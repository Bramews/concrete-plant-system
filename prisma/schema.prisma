  managedRejections     MaterialRejection[]    @relation("MaterialRejection_managerUserIdToUser")
  memberships           Membership[]
  mixDesigns            MixDesign[]
  passwordResetTokens   PasswordResetToken[]
  payrolls              Payroll[]
  testedQualityTests    QualityTest[]          @relation("QualityTest_testedByIdToUser")
  approvedQualityTests  QualityTest[]          @relation("QualityTest_approvedByIdToUser")
