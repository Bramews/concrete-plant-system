  createdUsers          User[]                 @relation("UserToUser")
  userDevices           UserDevice[]
  userPreference        UserPreference?
  userRoles             UserRole[]
  userSettings          UserSetting[]

  @@index([username])
  @@index([email])
  @@index([companyId])
}

