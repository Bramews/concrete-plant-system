{
  "name": "concrete-plant-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/start-dev.mjs",
    "build": "node --max-old-space-size=4096 node_modules/next/dist/bin/next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "check": "npm run lint && next build && npx prettier --check .",
    "prepare": "husky || true",
    "fix-rbac": "tsx fix-rbac-complete.ts",
    "backup": "node scripts/security-backup.mjs",
    "watch-backup": "node scripts/backup-watcher.mjs"
  },
  "lint-staged": {
    "*.{js,ts,tsx,css,md}": "prettier --write",
    "*.{js,ts,tsx}": "eslint --fix"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.3.0",
    "@prisma/client": "5.10.2",
    "@types/bcryptjs": "2.4.6",
    "bcrypt": "6.0.0",
    "bcryptjs": "3.0.3",
    "better-sqlite3": "12.6.2",
    "date-fns": "4.1.0",
    "framer-motion": "12.34.1",
    "googleapis": "171.4.0",
    "jose": "5.9.6",
    "jspdf": "4.2.0",
    "jspdf-autotable": "5.0.7",
    "lucide-react": "0.473.0",
    "mathjs": "15.2.0",
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "3.7.0",
    "resend": "6.9.1",
    "sonner": "2.0.7",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "1.49.0",
    "@types/bcrypt": "6.0.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "20.19.29",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.20",
    "eslint": "9.39.2",
    "eslint-config-next": "16.1.1",
    "husky": "9.1.5",
    "lint-staged": "15.2.10",
    "postcss": "8.4.49",
    "prettier": "3.3.3",
    "prisma": "5.10.2",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "1.0.7",
    "tsx": "4.21.0",
    "typescript": "5.7.2"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  }
}
